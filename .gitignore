# Recorded session data (EEG + video) -- large binary data, kept locally
# only, never pushed to git. Each session can be hundreds of MB to a few GB
# (raw EEG npz + screen recording mp4 + per-trial splits).
sessions/

# SEED benchmark dataset + processed derivatives -- large (GBs), was only
# used for an early cross-subject generalization comparison. Not needed to
# run the current own-data pipeline.
SEED/

# REFED project -- the repo carries only the code that actually runs models.
# Everything below stays local: regenerable outputs (feature caches ~250MB,
# prediction dumps, result JSON, figures, logs) and the exploratory /
# figure-making / dashboard scripts that are not needed to reproduce results.
# See refed/README.md section 7.
refed/*.npz
refed/*.log
refed/*_log.txt
refed/train_log*.txt
refed/*.png
refed/*.json
refed/*.html

refed/build_*.py
refed/dash_*.py
refed/fig_*.py
refed/diag_*.py
refed/tsne_*.py
refed/umap_*.py
refed/silhouette_*.py
refed/saliency_whole.py
refed/replot_saliency.py
refed/refed_montage_figures.py
refed/single_subject_regress.py
refed/seed_montage_classify.py
refed/seed_montage_classify_trunc.py
refed/seed_montage_classify_persubj.py

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

