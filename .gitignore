# Recorded session data (EEG + video) -- large binary data, kept locally
# only, never pushed to git. Each session can be hundreds of MB to a few GB
# (raw EEG npz + screen recording mp4 + per-trial splits).
sessions/

# SEED benchmark dataset + processed derivatives -- large (GBs), was only
# used for an early cross-subject generalization comparison. Not needed to
# run the current own-data pipeline.
SEED/

# REFED project -- extracted feature caches and prediction dumps (250MB+,
# regenerate via refed_extract_libeer.py / add_lds.py / the *_persubj*.py
# training scripts), run logs, and the per-trial/per-subject PNG tiles that
# are already embedded as base64 inside refed/dashboard.html. The curated
# report figures (fig_*.png) and the HTML deliverables themselves are kept.
refed/*.npz
refed/*.log
refed/*_log.txt
refed/train_log*.txt
refed/dash_*.png

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code local settings (machine-specific, not project config)
.claude/
